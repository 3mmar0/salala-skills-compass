Options -Indexes
DirectorySlash Off
RewriteEngine On

# Keep the Laravel API mount untouched.
RewriteRule ^backend(?:/|$) - [L]

# Never SPA-fallback hashed build assets. A missing asset must 404,
# otherwise CDNs can cache index.html as text/css and break the site.
RewriteRule ^(assets|shapes)/ - [L]

# Prefer exact prerender files for common hubs (avoids directory 301s).
RewriteRule ^courses$ courses/index.html [L]
RewriteRule ^about$ about/index.html [L]
RewriteRule ^contact$ contact/index.html [L]
RewriteRule ^consulting$ consulting/index.html [L]
RewriteRule ^library$ library/index.html [L]
RewriteRule ^landscape$ landscape/index.html [L]
RewriteRule ^faq$ faq/index.html [L]
RewriteRule ^policies$ policies/index.html [L]
RewriteRule ^entrepreneurship$ entrepreneurship/index.html [L]
RewriteRule ^breed-innovation$ breed-innovation/index.html [L]
RewriteRule ^solalaa-link$ solalaa-link/index.html [L]

# Prerender writes /path/index.html — serve for /path and /path/ (no 301).
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Real files pass through.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Frontend SPA fallback for app pages.
RewriteRule ^ index.html [L]

Options -Indexes
DirectorySlash Off
RewriteEngine On

# Keep the Laravel API mount untouched.
RewriteRule ^backend(?:/|$) - [L]

# Never SPA-fallback hashed build assets. A missing asset must 404,
# otherwise CDNs can cache index.html as text/css and break the site.
RewriteRule ^(assets|shapes)/ - [L]

# Prerender writes /path/index.html.
# Serve it for BOTH /path and /path/ with an internal rewrite only —
# never 301 between slash styles (that loops with Hostinger DirectorySlash).
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Real files pass through.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Frontend SPA fallback for app pages.
RewriteRule ^ index.html [L]

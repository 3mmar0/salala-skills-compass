Options -Indexes
DirectorySlash Off
RewriteEngine On

# Keep the Laravel API mount untouched.
RewriteRule ^backend(?:/|$) - [L]

# Never SPA-fallback hashed build assets. A missing asset must 404,
# otherwise CDNs can cache index.html as text/css and break the site.
RewriteRule ^(assets|shapes)/ - [L]

# Canonicalize: /courses/ → /courses (keep root / alone).
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ %1 [R=301,L]

# Prerender writes /path/index.html — serve it for /path without a trailing slash.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Real files pass through.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Frontend SPA fallback for app pages.
RewriteRule ^ index.html [L]
